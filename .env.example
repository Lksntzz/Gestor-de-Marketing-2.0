# Optional: enables Gemini-backed features. Keep this server-side only.
# If omitted, the application continues with the local rule engine/fallbacks.
GEMINI_API_KEY=""

# Optional: Google OAuth 2.0 Web Client ID used by the read-only Drive importer.
# Configure the OAuth client to allow the local origins used during development/installation.
# This value is a public OAuth client identifier, not a client secret.
VITE_GOOGLE_CLIENT_ID=""

# Optional deployment URL for environments that need self-referential links.
APP_URL=""
