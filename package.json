{
  "name": "nisti-marketing",
  "private": true,
  "version": "3.1.8",
  "packageManager": "bun@1.2.23",
  "description": "Nisti Marketing - sistema local-first de gestão de marketing integrado ao Obsidian e IA multi-provedor",
  "author": "Nisti Print Solutions",
  "main": "dist/electron-main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx secure-server.ts",
    "build": "vite build && node scripts/build-backend.mjs && esbuild src/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload.cjs && esbuild electron-bootstrap.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/electron-main.cjs",
    "start": "node dist/server.cjs",
    "electron:start": "electron dist/electron-main.cjs",
    "electron:dev": "bun run build && electron dist/electron-main.cjs",
    "electron:build": "bun run verify && bunx electron-builder@26.0.12 --win --x64",
    "electron:build:signed": "bun run verify && bunx electron-builder@26.0.12 --win --x64 --config.win.forceCodeSigning=true",
    "electron:build:all": "bun run verify && bunx electron-builder@26.0.12 --win --mac --linux",
    "dist": "bun run verify && bunx electron-builder@26.0.12",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('dist-electron',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "bun test tests/*.test.ts",
    "test:node": "node --import tsx --test tests-node/*.test.ts",
    "smoke:backend": "node scripts/runtime-smoke.mjs",
    "verify:preload": "node scripts/verify-preload-build.mjs",
    "verify": "npm run lint && npm run test && npm run test:node && npm run build && npm run verify:preload"
  },
  "build": {
    "appId": "com.nistiprint.pkm",
    "productName": "Nisti Marketing",
    "copyright": "Copyright © 2026 Nisti Print Solutions",
    "asar": false,
    "directories": {
      "output": "dist-electron"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Lksntzz",
        "repo": "Gestor-de-Marketing-2.0"
      }
    ],
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "legalTrademarks": "Nisti Print Solutions",
      "signAndEditExecutable": true,
      "forceCodeSigning": false
    },
    "nsis": {
      "artifactName": "Nisti-Marketing-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nisti Marketing",
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "pt_BR",
        "en_US"
      ],
      "displayLanguageSelector": false,
      "uninstallDisplayName": "Nisti Marketing"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/pdf-parse": "^1.1.5",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.0.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
