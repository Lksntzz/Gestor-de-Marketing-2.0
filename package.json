{
  "name": "nisti-pkm-marketing-hub",
  "private": true,
  "version": "0.1.7-patch.1",
  "main": "dist/electron-main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild src/preload.ts --bundle --platform=node --format=cjs --outfile=dist/preload.cjs && esbuild electron-main.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/electron-main.cjs",
    "start": "node dist/server.cjs",
    "electron:start": "electron dist/electron-main.cjs",
    "electron:dev": "bun run build && electron dist/electron-main.cjs",
    "electron:build": "bun run build && bunx electron-builder@26.0.12 --win --x64",
    "electron:build:all": "bun run build && bunx electron-builder@26.0.12 --win --mac --linux",
    "dist": "bun run build && bunx electron-builder@26.0.12",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('dist-electron',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "bun test",
    "verify": "bun run lint && bun test && bun run build"
  },
  "build": {
    "appId": "com.nistiprint.pkm",
    "productName": "Nisti Print PKM Marketing Hub",
    "copyright": "Copyright © 2026 Nisti Print Solutions",
    "asar": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "legalTrademarks": "Nisti Print PKM Solutions",
      "rfc3161TimeStampServer": "http://timestamp.digicert.com"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nisti Print PKM Marketing Hub",
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": ["pt_BR", "en_US"],
      "displayLanguageSelector": false,
      "uninstallDisplayName": "Nisti Print PKM Marketing Hub"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": ["AppImage", "deb"]
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/pdf-parse": "^1.1.5",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.0.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
